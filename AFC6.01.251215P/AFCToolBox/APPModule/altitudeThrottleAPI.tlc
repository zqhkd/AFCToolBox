%% File	   : altitudeThrottleAPI.tlc
%% Abstract:
%%		Target file for the C-Mex S-function crcengstat.c
%% Author  : ZQingHua @2019/02/18

%implements "altitudeThrottleAPI" "C"

%% Function: BlockTypeSetup ===========================================
%%
%function BlockTypeSetup(block, system) void
	%<LibAddToCommonIncludes("AFCBasicAPI.h")>
%endfunction %% BlockTypeSetup

%% Function: BlockInstanceSetup ===========================================
%%
%function BlockInstanceSetup(block, system) void

%endfunction %% BlockInstanceSetup

%% Function: Start ====================================================
%%
%function Start(block, system) Output
    %assign t_initF = SFcnParamSettings.r_initF
    %<t_initF>();
%endfunction %% Start

%% Function: Outputs ===================================================
%%
%function Outputs(block, system) Output
    %assign t_exeF = SFcnParamSettings.r_exeF

    %assign u_val1 = LibBlockInputSignal(0, "", "", 0)
    %assign u_val2 = LibBlockInputSignal(1, "", "", 0)
    %assign u_val3 = LibBlockInputSignal(2, "", "", 0)
    %assign u_val4 = LibBlockInputSignal(3, "", "", 0)
    %assign u_val5 = LibBlockInputSignal(4, "", "", 0)
    %assign u_val6 = LibBlockInputSignal(5, "", "", 0)
    %assign u_val7 = LibBlockInputSignal(6, "", "", 0)

    %assign y1 = LibBlockOutputSignal(0, "", "", 0)

    %<y1> = %<t_exeF>(%<u_val1>,%<u_val2>,%<u_val3>,%<u_val4>,%<u_val5>,%<u_val6>,%<u_val7>);
%endfunction %% Outputs

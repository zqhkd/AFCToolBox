%% File	   : ahrsNAPI.tlc
%% Abstract:
%%		Target file for the C-Mex S-function crcengstat.c
%% Author  : ZQingHua @2019/02/18

%implements "ahrsNAPI" "C"

%% Function: BlockTypeSetup ===========================================
%%
%function BlockTypeSetup(block, system) void
	%<LibAddToCommonIncludes("AFCBasicAPI.h")>
%endfunction %% BlockTypeSetup

%% Function: BlockInstanceSetup ===========================================
%%
%function BlockInstanceSetup(block, system) void

%endfunction %% BlockInstanceSetup

%% Function: Start ====================================================
%%
%function Start(block, system) Output

%endfunction %% Start

%% Function: Outputs ===================================================
%%
%function Outputs(block, system) Output
    %assign t_exeF = SFcnParamSettings.r_exeF

%% 将RollThreshold值强行设置为50，表示只有当信号或参数的维数等于或大于50时才生成for循环。由于生成for循环的这段代码有错，故做此处理
    %assign u_val11 = LibBlockInputSignal(0, "", "", 0)
    %assign u_val12 = LibBlockInputSignal(1, "", "", 0)
    %assign u_val13 = LibBlockInputSignal(2, "", "", 0)
    %assign u_val21 = LibBlockInputSignal(3, "", "", 0)
    %assign u_val22 = LibBlockInputSignal(4, "", "", 0)
    %assign u_val23 = LibBlockInputSignal(5, "", "", 0)
    %assign u_val3 = LibBlockInputSignal(6, "", "", 0)
    %assign u_val4 = LibBlockInputSignal(7, "", "", 0)

    %assign y1 = LibBlockOutputSignalAddr(0, "", "", 0)
    %assign y2 = LibBlockOutputSignalAddr(1, "", "", 0)

    %<t_exeF>(%<u_val11>,%<u_val12>,%<u_val13>,%<u_val21>,%<u_val22>,%<u_val23>,%<u_val3>,%<u_val4>, %<y1>,%<y2>);
    
%endfunction %% Outputs

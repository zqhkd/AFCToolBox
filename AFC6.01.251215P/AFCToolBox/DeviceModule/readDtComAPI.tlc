%% Function: Start ====================================================
%%
%function Start(block, system) Output
    %assign t_initF = SFcnParamSettings.r_initF
    %assign t_varNum = SFcnParamSettings.r_varNum
    %assign t_frameType = SFcnParamSettings.r_frameType
    %assign t_resFrameNum = SFcnParamSettings.r_resFrameNum
    %<t_initF>(%<t_varNum>,%<t_frameType>,%<t_resFrameNum>);
%endfunction %% Start

%% Function: Outputs ===================================================
%%
%function Outputs(block, system) Output
    %assign t_exeF = SFcnParamSettings.r_exeF
    %assign t_frameType = SFcnParamSettings.r_frameType

    %% ?RollThreshold??????50,??????????????????50????for???????for?????????,?????
    %openfile drvFunc
        void DtCom2ModelVar_%<t_frameType>(void){
        %assign rollVars = ["U"]
    %% 第一个端口为采集时刻点
        %assign y = LibBlockOutputSignal(0, "","", 0)
        %<y> = %<t_exeF>(%<t_frameType>,0);
%% 将RollThreshold值强行设置为50，表示只有当信号或参数的维数等于或大于50时才生成for循环。由于生成for循环的这段代码有错，故做此处理
        %roll sigIdx = RollRegions,lcv = 50,block,"Roller",rollVars
            %assign y = LibBlockOutputSignal(1, "",lcv, sigIdx)
            %assign dataSigIdx = sigIdx + 1
            %<y> = %<t_exeF>(%<t_frameType>,%<dataSigIdx>);
        %endroll
        }
    %closefile drvFunc
    %assign cFile = LibGetModelDotCFile()
    %<LibSetSourceFileSection(cFile,"Functions",drvFunc)>
    DtCom2ModelVar_%<t_frameType>();
%endfunction %% Outputs

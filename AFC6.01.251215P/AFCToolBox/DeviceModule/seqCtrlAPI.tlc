%% Function: Outputs ===================================================
%%
%function Outputs(block, system) Output
    %assign t_exeF = SFcnParamSettings.r_exeF
    %assign t_ledNo = SFcnParamSettings.r_ledNo
    %assign u_val = LibBlockInputSignal(0, "", "", 0)
    %<t_exeF>(%<t_ledNo>,%<u_val>);
%endfunction %% Outputs
